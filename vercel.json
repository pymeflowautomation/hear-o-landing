{
  "functions": {
    "api/auditor/analyze.js": {
      "maxDuration": 240,
      "includeFiles": "{node_modules/pdfkit/js/standard-fonts/**,public/images/logo-hear-o-pequeno2.png}"
    }
  },
  "redirects": [
    {
      "source": "/auditor-ia-centros-auditivos",
      "destination": "/auditoria-marketing-centros-auditivos",
      "permanent": true
    },
    {
      "source": "/prueba_auditica_online_para_centros_auditivos",
      "destination": "/prueba_auditica_online_para_centros_auditivos/",
      "permanent": false
    },
    {
      "source": "/guias/organizar-revisiones-garantias-renovaciones-audifonos",
      "destination": "/guias/ventas-renovacion-audifonos-centro-auditivo",
      "permanent": true
    },
    {
      "source": "/guias/alternativas-excel-agenda-manual-centros-auditivos",
      "destination": "/guias/informe-auditivo-vender-mas-audifonos",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
